-- Workspace > Scripts > ScriptCutter
-- Opens the ScriptCutter app with the open timeline (so the free version of Resolve works too).
-- Free version of Resolve: after "Create in Resolve" in the app, choose this entry again to build the timeline.
-- Generated by the ScriptCutter installer; run the installer again if you move the ScriptCutter folder.
SCRIPTCUTTER_EMBEDDED = true
local APP_DIR = [==[@APP_DIR@]==]
local BRIDGE_DIR = [==[@BRIDGE_DIR@]==]
local PYTHON = [==[@PYTHON@]==]
local PLAN_MAX_AGE = 30 * 60  -- seconds; an older prepared timeline is dropped and the app opens instead

local sc = dofile(APP_DIR .. "/resolve/scriptcutter.lua")
local plan_path = BRIDGE_DIR .. "/plan.lua"
local ok, plan = pcall(dofile, plan_path)
if ok and type(plan) == "table" and os.time() - (plan.created or 0) <= PLAN_MAX_AGE then
  -- the app prepared a timeline (free version of Resolve): build it now
  local result = sc.run("build", plan_path)
  sc.write_file(BRIDGE_DIR .. "/result.json", sc.json(result))
  os.remove(plan_path)
  print("[ScriptCutter] " .. (result.ok and ("Created timeline '" .. result.timeline .. "'") or tostring(result.error)))
  return
end
if ok then os.remove(plan_path) end

local context = sc.run("context")
sc.write_file(BRIDGE_DIR .. "/context.json", sc.json(context))
if not context.ok then print("[ScriptCutter] " .. tostring(context.error)) end
sc.launch(PYTHON, APP_DIR .. "/launcher.py")
